# Copy to .env and adjust. Every setting has a working default; nothing here is required.

# --- service ---
# FND_VAR_DIR=var
# FND_DATABASE_URL=sqlite+aiosqlite:///var/fnd.db
# FND_ARTIFACTS_DIR=ml/artifacts
# FND_LOG_LEVEL=INFO
# FND_LOG_JSON=true

# --- cache: disk by default, Redis when a URL is set ---
# FND_REDIS_URL=redis://localhost:6379/0

# --- limits ---
# FND_RATE_LIMIT_ANALYZE=30/minute
# FND_RATE_LIMIT_READ=120/minute
# FND_MAX_TEXT_CHARS=100000
# FND_MAX_FETCH_BYTES=5000000
# FND_FETCH_TIMEOUT_S=8

# --- external providers (used from milestone M3; the system works without them) ---
# ANTHROPIC_API_KEY=
# GOOGLE_FACTCHECK_API_KEY=
